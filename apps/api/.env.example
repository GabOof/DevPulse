# ============================================
# DEVPULSE - APPLICATION
# ============================================

NODE_ENV=development

HOST=0.0.0.0
PORT=3333


# ============================================
# REVERSE PROXY
# ============================================

# Mantenha false localmente.
#
# Configure true somente quando a API estiver
# atrás de um reverse proxy/load balancer
# confiável.

TRUST_PROXY=false


# ============================================
# DATABASE
# ============================================

DATABASE_URL=postgresql://devpulse:devpulse@localhost:5432/devpulse


# ============================================
# FRONTEND
# ============================================

FRONTEND_URL=http://localhost:5173


# ============================================
# GITHUB OAUTH
# ============================================

GITHUB_CLIENT_ID=your-github-client-id

GITHUB_CLIENT_SECRET=your-github-client-secret

GITHUB_CALLBACK_URL=http://localhost:3333/api/auth/github/callback


# ============================================
# AUTHENTICATION
# ============================================

SESSION_COOKIE_NAME=devpulse_session

# AES-256 key represented by
# 64 hexadecimal characters.
#
# Generate:
#
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

AUTH_ENCRYPTION_KEY=1111111111111111111111111111111111111111111111111111111111111111


# ============================================
# HTTP RATE LIMIT
# ============================================

RATE_LIMIT_MAX=120


# ============================================
# CACHE
# ============================================

# Repository overview:
# 5 minutes

CACHE_REPOSITORY_TTL_SECONDS=300

# Analytics:
# 2 minutes

CACHE_ANALYTICS_TTL_SECONDS=120
