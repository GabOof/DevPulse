# ============================================
# DEVPULSE - APPLICATION
# ============================================

NODE_ENV=development

HOST=0.0.0.0
PORT=3333

# ============================================
# REVERSE PROXY
# ============================================
#
# Mantenha false durante o desenvolvimento local.
#
# Configure como true somente quando a API estiver
# atrás de um reverse proxy ou load balancer confiável.
#
# Exemplo:
# Nginx
# Traefik
# Cloudflare
#
TRUST_PROXY=false

# ============================================
# DATABASE
# ============================================
#
# PostgreSQL utilizado pelo DevPulse.
#
# O valor abaixo corresponde à configuração
# padrão do docker-compose do projeto.
#
DATABASE_URL=postgresql://devpulse:devpulse@localhost:5432/devpulse

# ============================================
# FRONTEND
# ============================================
#
# Origem permitida para o frontend.
#
# Em produção, substitua pelo domínio real
# da aplicação.
#
FRONTEND_URL=http://localhost:5173

# ============================================
# GITHUB OAUTH
# ============================================
#
# Crie uma OAuth App em:
#
# GitHub
# Settings
# Developer settings
# OAuth Apps
#
# Durante o desenvolvimento local, utilize:
#
# Homepage URL:
# http://localhost:5173
#
# Authorization callback URL:
# http://localhost:3333/api/auth/github/callback
#
GITHUB_CLIENT_ID=your-github-client-id

GITHUB_CLIENT_SECRET=your-github-client-secret

GITHUB_CALLBACK_URL=http://localhost:3333/api/auth/github/callback

# ============================================
# AUTHENTICATION
# ============================================

SESSION_COOKIE_NAME=devpulse_session

# ============================================
# ENCRYPTION
# ============================================
#
# Chave AES-256 utilizada para proteger
# tokens do GitHub armazenados pelo backend.
#
# Deve possuir exatamente 32 bytes,
# representados por 64 caracteres hexadecimais.
#
# Gere uma chave utilizando:
#
# openssl rand -hex 32
#
# ou:
#
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# IMPORTANTE:
#
# - Nunca utilize a chave deste exemplo em produção.
# - Nunca versione a chave real no Git.
# - Alterar a chave em um ambiente existente
#   torna tokens anteriormente criptografados
#   ilegíveis.
#
AUTH_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters

# ============================================
# HTTP RATE LIMIT
# ============================================
#
# Número máximo de requisições permitido
# dentro da janela configurada pela aplicação.
#
RATE_LIMIT_MAX=120

# ============================================
# CACHE
# ============================================
#
# TTL em segundos.
#
# Repository Overview:
# 300 segundos = 5 minutos
#
CACHE_REPOSITORY_TTL_SECONDS=300

#
# Repository Analytics:
# 120 segundos = 2 minutos
#
CACHE_ANALYTICS_TTL_SECONDS=120
