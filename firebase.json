{
    "functions": {
        "source": "apps/api",
        "codebase": "devpulse-api",
        "runtime": "nodejs22",
        "disallowLegacyRuntimeConfig": true,
        "ignore": [
            "node_modules",
            ".git",
            "firebase-debug.log",
            "firebase-debug.*.log",
            "*.local",
            ".env",
            ".env.*"
        ],
        "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
}
